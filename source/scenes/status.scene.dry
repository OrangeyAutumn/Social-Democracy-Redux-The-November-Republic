title: Status
new-page: true
is-special: true
on-arrival: {!
Q.z_minus_bvp_votes = z_votes*0.8;
Q.bvp_votes = z_votes*0.2;
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

President: [+ president +] ([+ president_party +]) | [? if president == "Marx" : [+ marx_relation : relationships +] ?] | [? if president == "Hindenburg" : [+ hindenburg_relation : relationships +] ?]

