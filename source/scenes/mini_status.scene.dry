title: Mini Status
new-page: true
is-special: true
on-arrival: {!
Q.z_minus_bvp_votes = Math.round(Q.z_r * 0.8 * 10) / 10;
Q.bvp_votes = Math.round(Q.z_r * 0.2 * 10) / 10;
if (Q.unemployed) {
  Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
  Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
  Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

