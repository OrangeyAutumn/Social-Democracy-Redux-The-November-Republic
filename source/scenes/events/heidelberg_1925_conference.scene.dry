choose-if: (left_conference_votes < 50 and labor_conference_votes < 50 and (reformist_conference_votes+neorevisionist_conference_votes) < 50) or (center_leader == "Baade") or (center_leader == "Hirschfeld") or (center_leader == "Radbruch") or (center_leader == "Stampfer") or (center_leader == "Löbe")
