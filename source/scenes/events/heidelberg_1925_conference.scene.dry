title: Heidelberg Conference
subtitle: The SPD holds a party conference in Heidelberg
new-page: true
tags: event
view-if: year == 1925 and month >= 9
set-jump: post_congress
max-visits: 1

= Heidelberg Conference

The SPD is holding its biannual conference in the city of Heidelberg[? if ebert_dead == 1 : , the burial place of the recently deceased Friedrich Ebert ?]. Among the priorities on the agenda is the drafting of a new party program to replace the <span style="color: #ff6ba9;">** Görlitz**</span> program, which is seen by many as deviating too far from Marxism and as a result costing the **[+ spd_name_colour +]** amongst the working class.

Another issue is that of **Saxony,** where the regional party organization has split nearly in half over **Max Heldt's** decision to govern with the **[+ dvp_name_colour +]**.

- @faction_algorithm: The delegates enter...

@faction_algorithm
on-arrival: {!
if (Q.neorevisionism == 1) {
var factions = ["left", "center", "labor", "reformist", "neorevisionist"]
var factionNames = {'left': 'Left', 'center': 'Center', 'labor': 'Labor', 'reformist': 'Reformist', 'neorevisionist': 'Neorevisionist'}
}
else {
var factions = ["left", "center", "labor", "reformist"]
var factionNames = {'left': 'Left', 'center': 'Center', 'labor': 'Labor', 'reformist': 'Reformist'}
}
Q.conference_majority = "None";
Q.plurality_winner = "None";
Q.plurality_winner_conference_votes = 0;
Q.total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.neorevisionist_strength;
for (var faction of factions) {
Q[faction + '_conference_votes'] = 0 ;
Q[faction + '_conference_votes'] = Math.round((Q[faction + '_strength'] / Q.total_strength) * 1000) / 10;
    if (Q[faction + '_conference_votes'] >= 50) {
        Q.conference_majority = factionNames[faction];
    }
    if (Q[faction + '_conference_votes'] > Q.plurality_winner_conference_votes) {
        Q.plurality_winner = factionNames[faction];
        Q.plurality_winner_conference_votes = Q[faction + '_conference_votes'];
    }
}
!}
go-to: post_congress

@post_congress
on-display: {!
if (Q.neorevisionism == 1) {
var factions = ["left", "center", "labor", "reformist", "neorevisionist"],
factionNames = {'left': 'Left', 'center': 'Center', 'labor': 'Labor', 'reformist': 'Reformist', 'neorevisionist': 'Neorevisionist'}
factionColors = {'left': '#9c0000', 'center': '#e30000', 'labor': '#ff681d', 'reformist': '#ff6ba9', 'neorevisionist': '#e42bca'}
}
else {
var factions = ["left", "center", "labor", "reformist"],
factionNames = {'left': 'Left', 'center': 'Center', 'labor': 'Labor', 'reformist': 'Reformist'}
factionColors = {'left': '#9c0000', 'center': '#e30000', 'labor': '#ff681d', 'reformist': '#ff6ba9'}
}
var data = [];
for (var faction of factions) {
        data.push({
            "id": faction,
            "legend": factionNames[faction],
            "name": factionNames[faction],
	        "color": factionColors[faction],
           "seats": Math.round(Q[faction + '_conference_votes'] * 5),
        });
}
if (window && d3) {
    var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    } 

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

