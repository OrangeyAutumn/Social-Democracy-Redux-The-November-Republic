title: Heidelberg Conference
subtitle: The SPD holds a party conference in Heidelberg
new-page: true
tags: event
view-if: year == 1925 and month >= 9
set-jump: post_congress
max-visits: 1

# the low priority means that this event is only seen after all other events are resolved for the month.
# note: z_coalition = z_relation + (pro_cepublic/2); z_coalition *= 1.25 if z_faction_leader == "Joos";

= Heidelberg Conference

The SPD is holding its biannual conference in the city of Heidelberg, the burial place of the recently deceased Friedrich Ebert. Among the priorities on the agenda is the drafting of a new party program to replace the Görlitz program, which is seen by many as deviating too far from Marxism and as a result costing the SPD amongst the working class.

Another issue is that of Saxony, where the regional party organization has split nearly in half over Max Heldt's decision to govern with the DVP.

- @faction_algorithm: The delegates enter...

@faction_algorithm
on-arrival: {!

Q.left_votes = 0;
Q.center_votes = 0;
Q.reformist_votes = 0;
Q.labor_votes = 0;
Q.neorevisionist_votes = 0;

Q.total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.neorevisionist_strength;

Q.left_votes = Math.round((Q.left_strength / Q.total_strength) * 100);
Q.center_votes = Math.round((Q.center_strength / Q.total_strength) * 100);
Q.labor_votes = Math.round((Q.labor_strength / Q.total_strength) * 100);
Q.reformist_votes = Math.round((Q.reformist_strength / Q.total_strength) * 100);
Q.neorevisionist_votes = Math.round((Q.neorevisionist_strength / Q.total_strength) * 100);

Q.conference_majority = "None";
Q.plurality_winner = "None";
if (Q.left_votes >= 50) {
        Q.conference_majority = "Left";
           }
else if (Q.center_votes >= 50) {
        Q.conference_majority = "Center";
           }
else if (Q.reformist_votes >= 50) {
        Q.conference_majority = "Reformist";
           }
else if (Q.labor_votes >= 50) {
        Q.conference_majority = "Labor";
           }
else if (Q.neorevisionist_votes >= 50) {
        Q.conference_majority = "Neorevisionist";
           }
else {
Q.plurality_winner_votes = 0;
if (Q.left_votes > Q.plurality_winner_votes) {
    Q.plurality_winner = "Left";
    Q.plurality_winner_votes = Q.left_votes;
}
if (Q.center_votes > Q.plurality_winner_votes) {
    Q.plurality_winner = "Center";
    Q.plurality_winner_votes = Q.center_votes;
}
if (Q.labor_votes > Q.plurality_winner_votes) {
    Q.plurality_winner = "Labor";
    Q.plurality_winner_votes = Q.labor_votes;
}
if (Q.reformist_votes > Q.plurality_winner_votes) {
    Q.plurality_winner = "Reformist";
    Q.plurality_winner_votes = Q.reformist_votes;
}
if (Q.neorevisionist_votes > Q.plurality_winner_votes) {
    Q.plurality_winner = "Neorevisionist";
    Q.plurality_winner_votes = Q.neorevisionist_votes;
}
}
!}
go-to: post_congress

@post_congress
on-arrival: {!
Q.marxist_unity = Q.left_votes+Q.center_votes;
Q.toleration_unity = Q.center_votes+Q.reformist_votes+Q.neorevisionist_votes;
Q.lassalean_unity = Q.reformist_votes+Q.neorevisionist_votes;
Q.antitoleration_unity = Q.left_votes+Q.labor_votes;
Q.pragmatic_unity = Q.center_votes+Q.reformist_votes;
!}
on-display: {!
if (!Q.neorevisionism) {
    var data = [
        {   "id": "left",
            "legend": "Left",
            "name": "Left",
            "color": "#9c0000",
            "seats": Math.round(Q.left_votes*5),
        },
        {
            "id": "center",
            "legend": "Center",
            "name": "Center",
            "color": "#e30000",
            "seats": Math.round(Q.center_votes*5),
        },
        {
            "id": "labor",
            "legend": "Labor",
            "name": "Labor",
            "color": "#ff681d",
            "seats": Math.round(Q.labor_votes*5),
        },
        {
            "id": "reformist",
            "legend": "Reformists",
            "name": "Reformists",
            "color": "#ff6ba9",
            "seats": Math.round(Q.reformist_votes*5),
        },
];
}
else {
    var data = [

        {   "id": "left",
            "legend": "Left",
            "name": "Left",
            "color": "#9c0000",
            "seats": Math.round(Q.left_votes*5),
        },
        {
            "id": "center",
            "legend": "Center",
            "name": "Center",
            "color": "#e30000",
            "seats": Math.round(Q.center_votes*5),
        },
        {
            "id": "labor",
            "legend": "Labor",
            "name": "Labor",
            "color": "#ff681d",
            "seats": Math.round(Q.labor_votes*5),
        },
        {
            "id": "reformist",
            "legend": "Reformists",
            "name": "Reformists",
            "color": "#ff6ba9",
            "seats": Math.round(Q.reformist_votes*5),
        },
        {
            "id": "neorevisionist",
            "legend": "Neorevisionists",
            "name": "Neorevisionists",
            "color": "#e42bca",
            "seats": Math.round(Q.neorevisionist_votes*5),
        },
];
}
if (window && d3) {
    var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    } 

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

