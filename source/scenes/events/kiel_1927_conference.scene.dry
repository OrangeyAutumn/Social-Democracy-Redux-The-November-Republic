    Q.spd_coleader_3_fullname = "Friedrich Stampfer";
} else if (Q.left_leader == "Radbruch") {
    Q.spd_coleader_3 = "Radbruch";
    Q.spd_coleader_3_fullname = "Gustav Radbruch";
