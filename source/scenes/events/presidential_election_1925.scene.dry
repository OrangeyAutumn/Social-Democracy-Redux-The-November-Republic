// Center Candidate

@presidential_candidate_center_incumbent
title: Run President [+ president +], the incumbent.
subtitle: The incumbency may give us an advantage over fielding a new candidate.
view-if: president == "Müller" or president == "Wels" or president == "Vogel" or president == "Hilferding" or president == "Breitscheid"
on-arrival: {!
    center_campaign = 1;

    if (president == "Müller") {
        spd_presidential_candidate = "Müller";
    } else if (president == "Wels") {
        spd_presidential_candidate = "Wels";
    } else if (president == "Vogel") {
        spd_presidential_candidate = "Vogel";
    } else if (president == "Hilferding") {
        spd_presidential_candidate = "Hilferding";
    } else if (president == "Breitscheid") {
        spd_presidential_candidate = "Breitscheid";
    }
!}

